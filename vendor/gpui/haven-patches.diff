+/// Whether glyphs are rasterized with font smoothing (CoreText's "stem
+/// darkening", which native macOS text uses). Without it gpui's text is
+/// thinner and softer than AppKit's, most visibly on non-Retina displays.
+/// HAVEN PATCH: see vendor/gpui/HAVEN_PATCHES.md.
+static FONT_SMOOTHING: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(true);
+
+/// Enables or disables font smoothing. Takes effect on the next frame
+/// (refresh open windows to repaint).
+pub fn set_font_smoothing(enabled: bool) {
+    FONT_SMOOTHING.store(enabled, std::sync::atomic::Ordering::Relaxed);
+}
+
+/// Whether font smoothing is enabled (see [`set_font_smoothing`]).
+pub fn font_smoothing() -> bool {
+    FONT_SMOOTHING.load(std::sync::atomic::Ordering::Relaxed)
 }
 
